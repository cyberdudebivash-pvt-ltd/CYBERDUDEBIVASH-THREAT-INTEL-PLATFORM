// STIX ID: intel--d7f3bc41914e4dac
// SENTINEL APEX — Phishing Campaign Detection
// CVE/Threat: [OpenPhish] Phishing URL: https://s4w.in/roblox-com-users-1618139289-profile | Generated: 2026-08-15T08:55:39Z
let lookback = 7d;
let suspicious_exts = dynamic([".hta", ".lnk", ".iso", ".vhd", ".docm", ".xlsm", ".pptm"]);
EmailAttachmentInfo
| where Timestamp > ago(lookback)
| where FileName has_any (suspicious_exts)
| join kind=leftouter (
