// ── [SILVER] LyX security advisory
// Risk: 5.00 | Severity: MEDIUM
// STIX ID: intel--d5862121d3eca64b
// SENTINEL APEX — LyX security advisory — Anomalous Activity Detection
// Product: Web Application | Generated: 2026-08-18T09:02:37Z
let lookback = 1d;
SecurityEvent
| where TimeGenerated > ago(lookback)
| where EventID in (4625, 4648, 4728, 4740, 4776)
| summarize FailureCount = count(), DistinctTargets = dcount(TargetUserName)
    by IpAddress, bin(TimeGenerated, 1h)
| where FailureCount > 10 or DistinctTargets > 5
| extend Severity = "MEDIUM", CVE = "LyX security advisory", RuleSource = "SENTINEL-APEX"
| order by TimeGenerated desc

