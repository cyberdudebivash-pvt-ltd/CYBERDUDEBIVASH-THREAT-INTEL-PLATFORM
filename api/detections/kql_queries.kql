// SENTINEL APEX — North Korean Hackers Turn Trusted npm Packages Into a Gateway for Supply-Chain Attacks — Anomalous Activity Detection
// Product: Web Application | Generated: 2026-07-30T10:52:57Z
let lookback = 1d;
SecurityEvent
| where TimeGenerated > ago(lookback)
| where EventID in (4625, 4648, 4728, 4740, 4776)
| summarize FailureCount = count(), DistinctTargets = dcount(TargetUserName)
    by IpAddress, bin(TimeGenerated, 1h)
| where FailureCount > 10 or DistinctTargets > 5
| extend Severity = "MEDIUM", CVE = "North Korean Hackers Turn Trusted npm Packages Into a Gateway for Supply-Chain Attacks", RuleSource = "SENTINEL-APEX"
| order by TimeGenerated desc

