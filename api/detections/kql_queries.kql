// ── [STANDARD] Russian Intelligence Hackers Phish Signal Backup Keys to Hijack Accounts and Mes
// Risk: 5.00 | Severity: MEDIUM
// STIX ID: intel--8acb7fa2d87f7a50
// SENTINEL APEX — Phishing Campaign Detection
// CVE/Threat: Russian Intelligence Hackers Phish Signal Backup Keys to Hijack Accounts and Messages | Generated: 2026-07-30T10:52:57Z
let lookback = 7d;
let suspicious_exts = dynamic([".hta", ".lnk", ".iso", ".vhd", ".docm", ".xlsm", ".pptm"]);
EmailAttachmentInfo
| where Timestamp > ago(lookback)
| where FileName has_any (suspicious_exts)
| join kind=leftouter (
    EmailEvents | where Timestamp > ago(lookback)
        | where DeliveryAction !in ("Blocked", "Junked")
) on NetworkMessageId
| project Timestamp, RecipientEmailAddress, SenderFromAddress, FileName,
          Subject, DeliveryAction
| extend Severity = "HIGH", ThreatType = "Phishing", RuleSource = "SENTINEL-APEX"
| order by Timestamp desc

