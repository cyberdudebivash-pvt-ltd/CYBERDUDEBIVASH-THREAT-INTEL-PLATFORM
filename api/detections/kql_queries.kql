// STIX ID: intel--c4eb5845eac28e84
// SENTINEL APEX — Fwd: OpenZFS Linux open zpool manipulation and escapes via unprivileged userns — Anomalous Activity Detection
// Product: Web Application | Generated: 2026-08-17T09:10:37Z
let lookback = 1d;
SecurityEvent
| where TimeGenerated > ago(lookback)
| where EventID in (4625, 4648, 4728, 4740, 4776)
| summarize FailureCount = count(), DistinctTargets = dcount(TargetUserName)
    by IpAddress, bin(TimeGenerated, 1h)
| where FailureCount > 10 or DistinctTargets > 5
| extend Severity = "MEDIUM", CVE = "Fwd: OpenZFS Linux open zpool manipulation and escapes via unprivileged userns", RuleSource = "SENTINEL-APEX"
| order by TimeGenerated desc

