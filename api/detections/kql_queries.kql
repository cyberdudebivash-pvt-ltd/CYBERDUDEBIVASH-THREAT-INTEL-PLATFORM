// ── [SILVER] CVE-2026-14213 - Amelia < 2.4.6 - Provider+ Cross-Customer Appointment Data Disc
// CVE: CVE-2026-14213
// Risk: 1.60 | Severity: LOW
// STIX ID: intel--ee951a1d8c62f00e5359e077
// SENTINEL APEX — CVE-2026-14213 — Anomalous Activity Detection
// Product: Web Application | Generated: 2026-08-13T08:38:21Z
let lookback = 1d;
SecurityEvent
| where TimeGenerated > ago(lookback)
| where EventID in (4625, 4648, 4728, 4740, 4776)
| summarize FailureCount = count(), DistinctTargets = dcount(TargetUserName)
    by IpAddress, bin(TimeGenerated, 1h)
| where FailureCount > 10 or DistinctTargets > 5
| extend Severity = "MEDIUM", CVE = "CVE-2026-14213", RuleSource = "SENTINEL-APEX"
| order by TimeGenerated desc

