// ── [SILVER] ZDI-26-577: Trend Micro VPN OpenSSL Configuration Uncontrolled Search Path Eleme
// Risk: 7.00 | Severity: HIGH
// STIX ID: intel--43593cc634876e24
// SENTINEL APEX — CVE-2026-67212 — Anomalous Activity Detection
// Product: Web Application | Generated: 2026-08-14T09:35:38Z
let lookback = 1d;
SecurityEvent
| where TimeGenerated > ago(lookback)
| where EventID in (4625, 4648, 4728, 4740, 4776)
| summarize FailureCount = count(), DistinctTargets = dcount(TargetUserName)
    by IpAddress, bin(TimeGenerated, 1h)
| where FailureCount > 10 or DistinctTargets > 5
| extend Severity = "MEDIUM", CVE = "CVE-2026-67212", RuleSource = "SENTINEL-APEX"
| order by TimeGenerated desc

