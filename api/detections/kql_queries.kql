// ── [SILVER] [OpenPhish] Phishing URL: https://f6081e.icefactory.cl/TPs6kbk2KXyzBRq9pAwgsLbRy
// Risk: 7.00 | Severity: HIGH
// STIX ID: intel--d0bba0ada2988d03
// SENTINEL APEX — [OpenPhish] Phishing URL: https://f6081e.icefactory.cl/TPs6kbk2KXyzBRq9pAwgsLbRylGCoO3pgd4L79hDMb8xlsQdrFi0VT7ddX4t7HG4/?rotat — Anomalous Activity Detection
// Product: Web Application | Generated: 2026-08-14T09:35:38Z
let lookback = 1d;
SecurityEvent
| where TimeGenerated > ago(lookback)
| where EventID in (4625, 4648, 4728, 4740, 4776)
| summarize FailureCount = count(), DistinctTargets = dcount(TargetUserName)
    by IpAddress, bin(TimeGenerated, 1h)
| where FailureCount > 10 or DistinctTargets > 5
| extend Severity = "MEDIUM", CVE = "[OpenPhish] Phishing URL: https://f6081e.icefactory.cl/TPs6kbk2KXyzBRq9pAwgsLbRylGCoO3pgd4L79hDMb8xlsQdrFi0VT7ddX4t7HG4/?rotat", RuleSource = "SENTINEL-APEX"
| order by TimeGenerated desc

