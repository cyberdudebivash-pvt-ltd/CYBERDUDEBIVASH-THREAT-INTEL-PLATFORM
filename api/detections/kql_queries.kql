// ── [SILVER] [OpenPhish] Phishing URL: https://www.roblox.com.bn/games/107476030760322/Cart-R
// Risk: 7.00 | Severity: HIGH
// STIX ID: intel--d798c0263bfef06e
// SENTINEL APEX — Phishing Campaign Detection
// CVE/Threat: [OpenPhish] Phishing URL: https://www.roblox.com.bn/games/107476030760322/Cart-Ride-into-Spiderman?privateServerLinkCode=48576 | Generated: 2026-08-20T09:07:03Z
let lookback = 7d;
let suspicious_exts = dynamic([".hta", ".lnk", ".iso", ".vhd", ".docm", ".xlsm", ".pptm"]);
EmailAttachmentInfo
| where Timestamp > ago(lookback)
| where FileName has_any (suspicious_exts)
| join kind=leftouter (
    EmailEvents | where Timestamp > ago(lookback)
        | where DeliveryAction !in ("Blocked", "Junked")
) on NetworkMessageId
| project Timestamp, RecipientEmailAddress, SenderFromAddress, FileName,
          Subject, DeliveryAction
| extend Severity = "HIGH", ThreatType = "Phishing", RuleSource = "SENTINEL-APEX"
| order by Timestamp desc

