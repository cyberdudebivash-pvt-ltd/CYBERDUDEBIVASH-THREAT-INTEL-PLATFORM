    by IpAddress, bin(TimeGenerated, 1h)
| where FailureCount > 10 or DistinctTargets > 5
| extend Severity = "MEDIUM", CVE = "AWS Certificate Manager to Discontinue Email Validation for Public Certificates", RuleSource = "SENTINEL-APEX"
| order by TimeGenerated desc

