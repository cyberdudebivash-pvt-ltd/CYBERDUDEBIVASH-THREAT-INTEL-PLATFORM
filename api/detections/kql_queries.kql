// STIX ID: intel--dce46f7483f8a851
// SENTINEL APEX — LibreNMS: SSRF-driven stored XSS via Oxidized API response fields in device showconfig page — Anomalous Activity Detection
// Product: Web Application | Generated: 2026-08-19T01:42:21Z
let lookback = 1d;
SecurityEvent
| where TimeGenerated > ago(lookback)
| where EventID in (4625, 4648, 4728, 4740, 4776)
| summarize FailureCount = count(), DistinctTargets = dcount(TargetUserName)
    by IpAddress, bin(TimeGenerated, 1h)
| where FailureCount > 10 or DistinctTargets > 5
| extend Severity = "MEDIUM", CVE = "LibreNMS: SSRF-driven stored XSS via Oxidized API response fields in device showconfig page", RuleSource = "SENTINEL-APEX"
| order by TimeGenerated desc

