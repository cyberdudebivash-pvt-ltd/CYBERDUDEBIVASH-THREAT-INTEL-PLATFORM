// ── [STANDARD] New MessiahGPT AI Model Fueling Automated Ransomware and Phishing Attacks
// Risk: 6.76 | Severity: MEDIUM
// STIX ID: intel--2531910e976a860a66b968b8
// SENTINEL APEX — Phishing Campaign Detection
// CVE/Threat: New MessiahGPT AI Model Fueling Automated Ransomware and Phishing Attacks | Generated: 2026-08-17T09:10:37Z
let lookback = 7d;
let suspicious_exts = dynamic([".hta", ".lnk", ".iso", ".vhd", ".docm", ".xlsm", ".pptm"]);
EmailAttachmentInfo
| where Timestamp > ago(lookback)
| where FileName has_any (suspicious_exts)
| join kind=leftouter (
    EmailEvents | where Timestamp > ago(lookback)
        | where DeliveryAction !in ("Blocked", "Junked")
) on NetworkMessageId
| project Timestamp, RecipientEmailAddress, SenderFromAddress, FileName,
          Subject, DeliveryAction
| extend Severity = "HIGH", ThreatType = "Phishing", RuleSource = "SENTINEL-APEX"
| order by Timestamp desc

