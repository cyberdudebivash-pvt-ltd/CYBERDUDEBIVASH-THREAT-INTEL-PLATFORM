    by IpAddress, bin(TimeGenerated, 1h)
| where FailureCount > 10 or DistinctTargets > 5
| extend Severity = "MEDIUM", CVE = "SearXNG Basic Authentication Credentials Exposed Through MCP Logs and JSON-RPC Error Responses", RuleSource = "SENTINEL-APEX"
| order by TimeGenerated desc

