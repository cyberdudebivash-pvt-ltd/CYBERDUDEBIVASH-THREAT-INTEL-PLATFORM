// ── [GOLD] Cisco Firewall 0-Day Vulnerability Exploited in the Wild to Trigger DoS Conditio
// Risk: 9.00 | Severity: CRITICAL
// STIX ID: intel--8455cd9860113701
// SENTINEL APEX — CVE-2026-20349 — Anomalous Activity Detection
// Product: Web Application | Generated: 2026-08-13T08:38:21Z
let lookback = 1d;
SecurityEvent
| where TimeGenerated > ago(lookback)
| where EventID in (4625, 4648, 4728, 4740, 4776)
| summarize FailureCount = count(), DistinctTargets = dcount(TargetUserName)
    by IpAddress, bin(TimeGenerated, 1h)
| where FailureCount > 10 or DistinctTargets > 5
| extend Severity = "MEDIUM", CVE = "CVE-2026-20349", RuleSource = "SENTINEL-APEX"
| order by TimeGenerated desc

