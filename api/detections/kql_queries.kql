// ── [GOLD] Exploit for Out-of-bounds Read in Openssl
// Risk: 9.00 | Severity: CRITICAL
// STIX ID: intel--47151f7a06df19df
// SENTINEL APEX — CVE-2014-0160 — Anomalous Activity Detection
// Product: Web Application | Generated: 2026-08-19T01:42:21Z
let lookback = 1d;
SecurityEvent
| where TimeGenerated > ago(lookback)
| where EventID in (4625, 4648, 4728, 4740, 4776)
| summarize FailureCount = count(), DistinctTargets = dcount(TargetUserName)
    by IpAddress, bin(TimeGenerated, 1h)
| where FailureCount > 10 or DistinctTargets > 5
| extend Severity = "MEDIUM", CVE = "CVE-2014-0160", RuleSource = "SENTINEL-APEX"
| order by TimeGenerated desc

