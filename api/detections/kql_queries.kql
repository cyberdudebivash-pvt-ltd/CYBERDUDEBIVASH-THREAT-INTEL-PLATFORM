// ── [GOLD] Exploit for Authentication Bypass Using an Alternate Path or Channel in Connectw
// Risk: 9.00 | Severity: CRITICAL
// STIX ID: intel--5258af5b71785517
// SENTINEL APEX — CVE-2024-1709 — Anomalous Activity Detection
// Product: Web Application | Generated: 2026-08-15T08:55:39Z
let lookback = 1d;
SecurityEvent
| where TimeGenerated > ago(lookback)
| where EventID in (4625, 4648, 4728, 4740, 4776)
| summarize FailureCount = count(), DistinctTargets = dcount(TargetUserName)
    by IpAddress, bin(TimeGenerated, 1h)
| where FailureCount > 10 or DistinctTargets > 5
| extend Severity = "MEDIUM", CVE = "CVE-2024-1709", RuleSource = "SENTINEL-APEX"
| order by TimeGenerated desc

