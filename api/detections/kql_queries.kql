// ── [SILVER] Exploit for CVE-2026-76071
// CVE: CVE-2026-76071
// Risk: 7.00 | Severity: HIGH
// STIX ID: intel--9c61e76e4ba7e985
// SENTINEL APEX — CVE-2026-76071 — Anomalous Activity Detection
// Product: Web Application | Generated: 2026-08-20T09:07:03Z
let lookback = 1d;
SecurityEvent
| where TimeGenerated > ago(lookback)
| where EventID in (4625, 4648, 4728, 4740, 4776)
| summarize FailureCount = count(), DistinctTargets = dcount(TargetUserName)
    by IpAddress, bin(TimeGenerated, 1h)
| where FailureCount > 10 or DistinctTargets > 5
| extend Severity = "MEDIUM", CVE = "CVE-2026-76071", RuleSource = "SENTINEL-APEX"
| order by TimeGenerated desc

