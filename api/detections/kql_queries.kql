// ── [GOLD] TA488 May Have Exploited Outlook Web Access 0-Day Flaw Before Microsofts Emergen
// Risk: 9.00 | Severity: CRITICAL
// STIX ID: intel--84ad2fb8f1ffeb9c
// SENTINEL APEX — CVE-2026-42897 — Anomalous Activity Detection
// Product: Web Application | Generated: 2026-07-30T10:52:57Z
let lookback = 1d;
SecurityEvent
| where TimeGenerated > ago(lookback)
| where EventID in (4625, 4648, 4728, 4740, 4776)
| summarize FailureCount = count(), DistinctTargets = dcount(TargetUserName)
    by IpAddress, bin(TimeGenerated, 1h)
| where FailureCount > 10 or DistinctTargets > 5
| extend Severity = "MEDIUM", CVE = "CVE-2026-42897", RuleSource = "SENTINEL-APEX"
| order by TimeGenerated desc

