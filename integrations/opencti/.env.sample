# Copy to .env, fill in the real values, and never commit the filled-in file.
OPENCTI_URL=https://your-opencti-instance.example.com
OPENCTI_TOKEN=your-opencti-admin-or-connector-token
SENTINEL_APEX_API_KEY=cdb_ent_your_real_key_here
# Optional overrides -- see docker-compose.yml comments for what each does.
